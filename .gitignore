# LedgeIndex monorepo — applies under apps/, packages/, hosts/
# Dependencies (workspace hoisting still leaves local node_modules sometimes)
node_modules/

# Next.js (@ledgeindex/web)
.next/
out/

# Builds (dist-* covers local electron-builder dirs like dist-v3 / dist-verify)
dist/
dist-*/
*.asar
build/
*.tsbuildinfo

# Turbo / tooling
.turbo/
.vercel/

# Env (vault is committed; decrypted env is not)
.env
.env.local
.env.*.local
!.env.vault
!.env.project

# Local LedgeIndex runtime (LibSQL, FileStore, vector index)
.data/
*.db
*.db-shm
*.db-wal
*.duckdb
*.duckdb.wal

# Test / coverage
coverage/
.nyc_output/

# Generated evaluation corpus snapshots
evals/corpora/

# OS / editor
.DS_Store
Thumbs.db

# FastEmbed / local ML cache (docs ingest)
local_cache/

# Local smoke outputs / repo explore smokes (not published)
.smoke-out/
packages/repo/.smoke-out/
packages/repo/scripts/

# Local GitHub PATs — never commit
PAT_LEDGEINDEX
PAT_LEDDGEINDEX
LEDGEINDEX_PUBLIC_PUSH_TOKEN
.pat-ledgeindex

# Docs discovery / crawl scratch (local only)
.cache/
storage/

# Maintained locally for now (Source updater starting list)
top-typescript-docs.json
top-typescript-docs.*.json

# Exclude-pattern proposer outputs (local scratch; results live in top-typescript-docs / catalog)
docs-exclude-*.json
docs-exclude-*.patterns.json

# Repomix pack output (config stays tracked)
repomix-output.*
repomix-*.xml
