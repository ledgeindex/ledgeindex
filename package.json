{
  "name": "ledgeindex",
  "version": "0.1.0",
  "private": true,
  "description": "LedgeIndex monorepo — packages, hosts, apps",
  "license": "LicenseRef-LedgeIndex-Sustainable-Use-1.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "hosts/*"
  ],
  "scripts": {
    "dev:web": "npm run dev -w @ledgeindex/web",
    "build:web": "npm run build -w @ledgeindex/web",
    "start:web": "npm run start -w @ledgeindex/web",
    "dev:api": "npm run dev -w @ledgeindex/hosts-api",
    "build:api": "npm run build -w @ledgeindex/hosts-api",
    "start:api": "npm run start -w @ledgeindex/hosts-api",
    "dev:docs": "npm run dev -w @ledgeindex/docs-site",
    "build:docs": "npm run build -w @ledgeindex/docs-site",
    "start:docs": "npm run start -w @ledgeindex/docs-site",
    "dev:mobile": "npm run start -w @ledgeindex/mobile",
    "android:mobile": "npm run android -w @ledgeindex/mobile",
    "dev:desktop": "npm run dev -w @ledgeindex/desktop",
    "release:desktop": "node scripts/release-desktop.mjs",
    "build:packages": "npm run build -w @ledgeindex/core -w @ledgeindex/repo -w @ledgeindex/profile -w @ledgeindex/docs -w @ledgeindex/client -w @ledgeindex/sdk -w @ledgeindex/ag -w @ledgeindex/server -w @ledgeindex/model -w ledgeindex",
    "upload:widget": "node scripts/upload-widget-gcs.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "publish:packages:dry-run": "node scripts/publish-packages.mjs --dry-run",
    "publish:packages": "node scripts/publish-packages.mjs",
    "release:packages": "node scripts/release-packages.mjs",
    "release:packages:check": "node scripts/release-packages.mjs --check",
    "eval:golden": "node --env-file=../.env scripts/run-retrieval-eval.mjs --golden scripts/golden/mastra-50.json",
    "eval:golden:pr": "node --env-file=../.env scripts/run-retrieval-eval.mjs --golden scripts/golden/mastra-50.json --profile pr --out results/mastra-pr-current.json",
    "eval:golden:full": "node --env-file=../.env scripts/run-retrieval-eval.mjs --golden scripts/golden/mastra-50.json --profile full --out results/mastra-full-current.json",
    "eval:golden:smoke": "node scripts/golden-retrieve.mjs --golden scripts/golden/mastra.json",
    "eval:golden:generate": "node scripts/generate-retrieval-golden.mjs"
  },
  "devDependencies": {
    "prettier": "^3.7.4"
  },
  "overrides": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "lucide-react": "1.30.0"
  }
}
