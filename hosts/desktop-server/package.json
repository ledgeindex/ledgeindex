{
  "name": "@ledgeindex/desktop-server",
  "version": "0.1.0",
  "private": true,
  "description": "LedgeIndex desktop Electron sidecar host (docs + profile via @ledgeindex/server)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/start.ts",
    "dev:sidecar": "tsx src/start.ts",
    "dev:sidecar:watch": "tsx watch src/start.ts",
    "build": "esbuild src/start.ts --bundle --outfile=dist/start.js --platform=node --format=esm --packages=external",
    "start": "node dist/start.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@ledgeindex/docs": "^0.1.14",
    "@ledgeindex/server": "^0.1.14"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2"
  }
}
