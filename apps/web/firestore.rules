rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // Self-signup may only ever mint a free, non-admin account. The API trusts
      // this document for admin checks, so "role in [user, admin]" would let a new
      // user hand themselves admin on their very first write.
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.plan == "free"
        && request.resource.data.role == "user";

      // plan and role are server-owned: the Admin SDK writes them and bypasses
      // these rules, so freezing them here blocks self-approval.
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.plan == resource.data.plan
        && request.resource.data.role == resource.data.role;
    }
  }
}
