{
  "name": "@ledgeindex/docs",
  "version": "0.1.17",
  "description": "LedgeIndex docs profile — sources, ingest, chat, MCP",
  "type": "module",
  "license": "LicenseRef-LedgeIndex-Sustainable-Use-1.0",
  "author": "LedgeIndex",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ledgeindex/ledgeindex.git",
    "directory": "ledgeindex/packages/docs"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": "./dist/index.js",
    "./runtime/*": "./dist/runtime/*"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run clean && npm run build",
    "build": "tsup",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "test:agent-readiness": "node --import tsx --test src/runtime/openapi/public-api-spec.test.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "2.0.86",
    "@ai-sdk/openai": "^2.0.114",
    "@ledgeindex/core": "^0.1.17",
    "@ledgeindex/repo": "^0.1.17",
    "@mastra/ai-sdk": "^1.6.2",
    "@mastra/core": "^1.51.0",
    "@mastra/fastembed": "^1.2.0",
    "@mastra/fastify": "^1.4.7",
    "@mastra/libsql": "^1.16.0",
    "@mastra/loggers": "^1.2.0",
    "@mastra/mcp": "^1.14.0",
    "@mastra/pg": "^1.16.0",
    "@mastra/rag": "^2.4.1",
    "@mozilla/readability": "^0.6.0",
    "chalk": "^5.6.2",
    "cheerio": "^1.2.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.10.0",
    "fastify-plugin": "^6.0.0",
    "firebase-admin": "^14.2.0",
    "inngest": "^4.13.0",
    "jsdom": "^29.1.1",
    "pg": "^8.22.0",
    "pretty-error": "^4.0.0",
    "turndown": "^7.2.4",
    "zod": "3.25.76"
  },
  "optionalDependencies": {
    "@browserbasehq/stagehand": "^3.1.0"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.10.0",
    "tsup": "^8.5.1",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js"
}
