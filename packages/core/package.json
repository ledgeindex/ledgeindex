{
  "name": "@ledgeindex/core",
  "version": "0.1.7",
  "description": "LedgeIndex primitives — crawl, extract, chunk, embed, persist, query",
  "type": "module",
  "license": "LicenseRef-LedgeIndex-Sustainable-Use-1.0",
  "author": "LedgeIndex",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ledgeindex/ledgeindex.git",
    "directory": "ledgeindex/packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": "./dist/index.js",
    "./chunk": "./dist/chunk/index.js",
    "./chunk/*": "./dist/chunk/*",
    "./chunk-pipeline/*": "./dist/chunk-pipeline/*",
    "./crawl/*": "./dist/crawl/*",
    "./enrich": "./dist/enrich/index.js",
    "./enrich/*": "./dist/enrich/*",
    "./extract/parser/*": "./dist/extract/parser/*",
    "./ingest/*": "./dist/ingest/*",
    "./query/*": "./dist/query/*",
    "./vector/*": "./dist/vector/*",
    "./db/*": "./dist/db/*",
    "./schemas/*": "./dist/schemas/*",
    "./lib/*": "./dist/lib/*",
    "./llm/chat-model-config": "./dist/llm/chat-model-config.js",
    "./llm/chat-model-config.js": "./dist/llm/chat-model-config.js",
    "./llm/models": "./dist/llm/models.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run clean && npm run build",
    "build": "tsup",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@ai-sdk/google": "2.0.86",
    "@ai-sdk/openai": "^2.0.114",
    "@apify/log": "^2.5.26",
    "@huggingface/transformers": "^3.8.1",
    "@mastra/core": "^1.51.0",
    "@mastra/fastembed": "^1.2.0",
    "@mastra/libsql": "^1.16.0",
    "@mastra/pg": "^1.16.0",
    "@mastra/rag": "^2.4.1",
    "@mozilla/readability": "^0.6.0",
    "cheerio": "^1.2.0",
    "crawlee": "^3.17.0",
    "firebase-admin": "^14.2.0",
    "gpt-tokenizer": "^3.4.0",
    "jsdom": "^29.1.1",
    "pg": "^8.22.0",
    "turndown": "^7.2.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/turndown": "^5.0.5",
    "tsup": "^8.5.1",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js"
}
