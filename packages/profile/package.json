{
  "name": "@ledgeindex/profile",
  "version": "0.1.17",
  "description": "LedgeIndex profile — site/entity research profiles, landscape runs",
  "type": "module",
  "license": "LicenseRef-LedgeIndex-Sustainable-Use-1.0",
  "author": "LedgeIndex",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ledgeindex/ledgeindex.git",
    "directory": "ledgeindex/packages/profile"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": "./dist/index.js",
    "./profile": "./dist/profile.js",
    "./research/crawl-catalog": "./dist/research/crawl-catalog.js",
    "./research/fetch-picked-pages": "./dist/research/fetch-picked-pages.js",
    "./research/synthesize-answer": "./dist/research/synthesize-answer.js",
    "./research/synthesize-lens": "./dist/research/synthesize-lens.js",
    "./research/research-lenses": "./dist/research/research-lenses.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run clean && npm run build",
    "build": "tsup",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@ledgeindex/core": "^0.1.17",
    "@mastra/core": "^1.51.0",
    "exa-js": "^2.16.0",
    "fastify": "^5.10.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "tsup": "^8.0.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js"
}
