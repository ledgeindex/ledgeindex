# Copy to .env (ledgeindex root) or hosts/api/.env
# Local defaults. Production URLs belong in your private vault / CI, not this file.

PORT=3010
HOST=0.0.0.0
LEDGEINDEX_PROFILES=docs,profile
LEDGEINDEX_AUTH_REQUIRED=0
# LEDGEINDEX_DATA_DIR=./.data

# MCP: advertised origin for /mcp and OAuth discovery.
MASTRA_PUBLIC_URL=http://localhost:3010
# MCP OAuth sends the browser here: {LEDGEINDEX_FRONTEND_URL}/mcp/connect
LEDGEINDEX_FRONTEND_URL=http://localhost:3004

# GOOGLE_GENERATIVE_AI_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# COHERE_API_KEY=
# LEDGEINDEX_VECTOR_BACKEND=libsql
