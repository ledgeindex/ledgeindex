# Copy to .env (ledgeindex root) or hosts/api/.env
# Local defaults. Production URLs belong in your private vault / CI, not this file.

PORT=3010
HOST=0.0.0.0
LEDGEINDEX_PROFILES=docs,profile
LEDGEINDEX_AUTH_REQUIRED=0
# LEDGEINDEX_DATA_DIR=./.data

# Prod cloud only: enforce free-plan limits (1 source set, 3 sources/set). Off by default.
# When enabled, web shows Billing nav + upgrade modals (reads flag from API — no web env needed).
# Free plan: max 3 personal/public sources, 1 source set, 3 sources per set.
# Free plan daily chat/ask budget (UTC midnight reset, default 25) when plan limits are on.
# LEDGEINDEX_FREE_DAILY_MESSAGES=25
# LEDGEINDEX_APPLY_PLAN_LIMITS=1
# Optional Paddle checkout (only used when plan limits are enabled):
# LEDGEINDEX_PADDLE_CLIENT_TOKEN=
# LEDGEINDEX_PADDLE_ENVIRONMENT=sandbox
# LEDGEINDEX_PRO_PRICE_MONTHLY=
# LEDGEINDEX_PRO_PRICE_ANNUAL=

# MCP: advertised origin for /mcp and OAuth discovery.
MASTRA_PUBLIC_URL=http://localhost:3010
# MCP OAuth sends the browser here: {LEDGEINDEX_FRONTEND_URL}/mcp/connect
LEDGEINDEX_FRONTEND_URL=http://localhost:3004

# GOOGLE_GENERATIVE_AI_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# COHERE_API_KEY=
# LEDGEINDEX_VECTOR_BACKEND=libsql
#
# --- Postgres / pgvector (docker-compose.postgres.yml or self-hosted) ---
# POSTGRES_CONNECTION_STRING=postgresql://ledgeindex:ledgeindex@localhost:5432/ledgeindex
# LEDGEINDEX_VECTOR_BACKEND=pgvector
# LEDGEINDEX_RERANK_BACKEND=cohere-auto
